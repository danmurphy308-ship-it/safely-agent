{
  "name": "safely-agent",
  "version": "1.0.0",
  "description": "Node.js + Express backend",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:server\" \"npm run client\"",
    "dev:server": "node --watch index.js",
    "client": "npm run dev --prefix client",
    "db:init": "node src/db/run.js src/db/schema.sql",
    "db:reset": "node src/db/run.js src/db/drop.sql src/db/schema.sql",
    "db:test": "node src/db/test-connection.js",
    "test:scorer": "node src/scripts/testScorer.js",
    "test:drafter": "node src/scripts/testDrafter.js",
    "test:apollo": "node src/scripts/testApollo.js",
    "test:clay-search": "node src/scripts/testClaySearch.js",
    "test:hubspot": "node src/scripts/testHubspot.js",
    "test:verify-email": "node src/scripts/testVerifyEmail.js",
    "test:heygen": "node src/scripts/testHeygen.js",
    "user:set-password": "node src/scripts/setUserPassword.js",
    "instantly:sync-sequence": "node src/scripts/syncInstantlySequence.js",
    "instantly:fix-legacy-bodies": "node src/scripts/fixLegacyBodies.js",
    "instantly:audit-campaigns": "node src/scripts/auditInstantlyCampaigns.js",
    "aimfox:backfill": "node src/scripts/aimfoxBackfill.js",
    "instantly:backfill-replies": "node src/scripts/backfillInstantlyReplies.js",
    "rescue:linkedin-only": "node src/scripts/rescueLinkedinOnly.js",
    "reverify:campaign-backlog": "node src/scripts/reverifyCampaignBacklog.js",
    "fix:stale-reply-status": "node src/scripts/fixStaleReplyStatuses.js",
    "cleanup:zombie-drafts": "node src/scripts/cleanupZombieDraftedLeads.js",
    "aimfox:register-webhook": "node src/scripts/registerAimfoxWebhook.js",
    "seed:kb": "node src/scripts/seedKnowledgeBase.js",
    "import:csv": "node src/scripts/importCSV.js",
    "export:emails": "node src/scripts/exportEmails.js",
    "batch:process": "node src/scripts/batchProcess.js",
    "move:leads": "node src/scripts/moveLeads.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "axios": "^1.17.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.1",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.7.10",
    "concurrently": "^10.0.3"
  }
}
