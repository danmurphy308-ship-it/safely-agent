# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Anthropic 
ANTHROPIC_API_KEY=

# Clay — Public API (synchronous search + email enrichment). Used when a
# campaign's lead source is "clay". Create the key in the Clay app under
# Settings → Account → API keys (beta). Leave empty to disable (Clay
# findLeads no-ops and returns nothing).
CLAY_PUBLIC_API_KEY=
# Routine id of the Clay-managed work-email function (looks like function:t_...).
# Find it via `clay routines list` or the Clay app. Leave empty to skip email
# enrichment — searched leads are then saved without emails.
CLAY_EMAIL_ROUTINE_ID=

# Clay — legacy webhook/table model (POST /api/webhooks/clay callback flow)
CLAY_API_KEY=
CLAY_WEBHOOK_URL=
# Optional shared secret to authenticate inbound POST /api/webhooks/clay
CLAY_WEBHOOK_SECRET=

# Apollo
APOLLO_API_KEY=

# Scheduling — booking link that replaces the [SCHEDULING_LINK] placeholder in drafted emails
SCHEDULING_LINK=

# Instantly
INSTANTLY_API_KEY=
INSTANTLY_CAMPAIGN_ID=
# Optional shared secret to authenticate inbound POST /api/webhooks/instantly
INSTANTLY_WEBHOOK_SECRET=

# Aimfox (LinkedIn outreach) — leads scoring 70+ with a LinkedIn URL are added
# to an Aimfox campaign. Leave AIMFOX_API_KEY empty to disable entirely.
# Use a "normal" API key (Workspace Settings -> Integrations), not the master key.
AIMFOX_API_KEY=
# Fallback Aimfox campaign UUID when a campaign has no aimfox_campaign_id set
AIMFOX_CAMPAIGN_ID=
# Optional shared secret for inbound POST /api/webhooks/aimfox. Must match the
# webhook's Authentication Header in Aimfox (Bearer <secret>).
AIMFOX_WEBHOOK_SECRET=

# HeyReach (LinkedIn outreach, campaign-based like Aimfox) — leave
# HEYREACH_API_KEY empty to disable entirely (addLeadToCampaign no-ops).
HEYREACH_API_KEY=
# Target campaign id leads are added to.
HEYREACH_CAMPAIGN_ID=
# Optional shared secret for inbound POST /api/webhooks/heyreach (Bearer
# convention assumed — HeyReach's actual outbound auth isn't confirmed yet).
HEYREACH_WEBHOOK_SECRET=
# Set to log full HeyReach request/response detail.
HEYREACH_DEBUG=

# LaGrowthMachine (LGM) — LinkedIn + email outreach client. EXPLORATORY: not
# wired into the pipeline yet. Leave LGM_API_KEY empty unless resuming that work.
LGM_API_KEY=
# Set to log full LGM request/response detail.
LGM_DEBUG=

# HubSpot
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=

# HeyGen (personalized video for leads scoring 85+) — leave HEYGEN_API_KEY
# empty to disable entirely (generateVideoForLead no-ops, leads send without
# a video). HEYGEN_TEMPLATE_ID is the template used for every generation.
HEYGEN_API_KEY=
HEYGEN_TEMPLATE_ID=

# Reply notifications (Gmail SMTP)
# Address that receives an alert when a lead replies to outreach
NOTIFICATION_EMAIL=
# Gmail SMTP — use an App Password (not your account password) for SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional From address; defaults to SMTP_USER if unset
SMTP_FROM=

# Auth — signs the httpOnly session cookie (30-day expiry). Any long random
# string; changing it invalidates every existing session. Required for login
# to work (cookie-parser throws without a secret).
SESSION_SECRET=

# CORS
CORS_ORIGIN=http://localhost:3000
